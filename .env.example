# Copy this file to .env. Never put this key in frontend code.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
# Native streaming audio uses a separate Live API model.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore
PORT=3000
# auto: Gemini when a key is present, deterministic demo otherwise.
# demo: always use offline demo workflows.
AI_MODE=auto
DATABASE_PATH=./data/uzex-demo.sqlite
